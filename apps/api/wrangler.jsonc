{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cimarket-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",

  "env": {
    "dev": {
      "name": "cimarket-api-dev",
      "secrets": {
        "required": [
          "DATABASE_URL",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "JWT_ACCESS_SECRET",
          "JWT_REFRESH_SECRET",
        ],
      },
    },
    "production": {
      "name": "cimarket-api",
      "required": [
        "DATABASE_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
      ],
    },
  },
  // "compatibility_flags": [
